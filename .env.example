# Copie este arquivo para .env e preencha. Nunca envie o .env ao Git.

# URL do projeto (Supabase > Project Settings > API). Sem barra no final e sem "db." na frente.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave SECRETA (Supabase > Project Settings > API Keys > "Secret keys": sb_secret_...
# ou a legacy "service_role"). NUNCA use a anon/publishable aqui. Só o backend usa esta chave.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: chave publicável/anon. O servidor só a usa para validar que não é igual à service role.
SUPABASE_ANON_KEY=

# Segredo longo e aleatório para assinar as sessões. Gere com: openssl rand -hex 48
JWT_SECRET=

# Porta da API (padrão 3001) e origem permitida no CORS (padrão http://localhost:5173)
PORT=3001
CORS_ORIGIN=http://localhost:5173
